# ===== 网易云会员 Cookie（重要）=====
# 复制你浏览器登录网易云后拿到的 Cookie（包含 MUSIC_U 那段）。
# 填了才能解锁 VIP/付费歌曲与高码率；不填则只能播免费试听片段。
# 获取方法见 README「获取网易云 Cookie」。
METING_NETEASE_COOKIE=

# ===== 其他平台 Cookie（可选）=====
METING_TENCENT_COOKIE=
METING_KUGOU_COOKIE=
METING_KUWO_COOKIE=

# ===== 兜底 Cookie（可选，所有平台共用）=====
METING_COOKIE=

# ===== 端口（Railway 自动注入 PORT，本地调试可改成 8765）=====
# PORT=8765
